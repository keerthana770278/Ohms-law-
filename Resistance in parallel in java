import java.util.Scanner;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        double r1 = sc.nextDouble();
        double r2 = sc.nextDouble();
        double r = (r1*r2)/(r1+r2);
        System.out.println("Parallel Resistance = " + r);
    }
}
